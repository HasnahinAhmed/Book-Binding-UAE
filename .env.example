# Copy to .env.local for development. Never commit real values.

# Public site URL (used for canonical URLs, sitemap, auth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business contact (public)
NEXT_PUBLIC_WHATSAPP_NUMBER=971525294086
NEXT_PUBLIC_INSTAGRAM_HANDLE=book_binding_uae

# --- Server only (never exposed to the browser) ---
# Private file storage for uploaded thesis PDFs. Must be outside public/.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/private
# Max upload size in MB (owner decision D7; 50 is the current default)
UPLOAD_MAX_MB=50
# 1 only when behind a proxy that overwrites X-Forwarded-For (Vercel, Cloudflare, nginx)
TRUST_PROXY=0

# PostgreSQL (accounts, orders, saved designs). Run `npm run db:migrate` after setting it.
DATABASE_URL=postgresql://user:password@localhost:5432/bookbinding
# Session signing secret, 32+ characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Added in later milestones ---
# PAYMENT_PROVIDER=      # not chosen yet
